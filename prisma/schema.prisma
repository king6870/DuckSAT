// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}


datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Onboarding survey fields
  onboardingCompleted Boolean  @default(false)
  highestSATScore     Int?
  bluebookTestsTaken  Int?
  otherPrepApps       String?  @db.Text // JSON array of app names
  strongCategories    String?  @db.Text // JSON array of categories user is good at
  weakCategories      String?  @db.Text // JSON array of categories user struggles with
  targetScore         Int?
  gradeLevel          String?  // e.g., "freshman", "sophomore", "junior", "senior"

  // Stripe subscription fields
  stripeCustomerId     String?   // Stripe Customer ID (cus_xxx)
  subscriptionPlan     String    @default("free")  // 'free' | 'monthly' | 'yearly'
  subscriptionStatus   String    @default("none")  // 'none' | 'trialing' | 'active' | 'past_due' | 'canceled' | 'unpaid'
  stripeSubscriptionId String?   // Stripe Subscription ID (sub_xxx)
  currentPeriodEnd     DateTime? // When the current billing period ends
  trialEnd             DateTime? // When the trial period ends
  cancelAtPeriodEnd    Boolean   @default(false) // Whether subscription will cancel at period end

  // Username + password auth fields (null for Google-only accounts)
  username     String?  // stored lowercase; @unique enforced via filtered DB index
  passwordHash String?  // bcrypt hash (cost 12); never exposed via API or session

  // Tester / promo fields
  isTester       Boolean   @default(false)
  promoCodeUsed  String?   // e.g. 'DUCK19'

  // Feedback
  feedbackSubmittedAt DateTime? // null = never submitted a site review

  // Referral fields
  referralCode       String?  @unique  // user's own share code (8-char alphanumeric)
  referredByCode     String?           // code they entered when signing up
  bonusPracticeTests Int      @default(0) // extra practice tests earned from referrals

  // QR code tracking
  joinedViaQrCode    Boolean   @default(false)
  qrCodeJoinedAt     DateTime?

  // Relations
  accounts    Account[]
  sessions    Session[]
  testResults TestResult[]
  questionReviews QuestionReview[]
  feedback    UserFeedback[]
  referralsSent     Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferee")
  
  @@map("users")
}

// Referral tracking
model Referral {
  id          String   @id @default(cuid())
  referrerId  String   // User who shared the code
  refereeId   String   // User who used the code
  codeUsed    String   // The actual code at time of referral
  awardedAt   DateTime @default(now())

  referrer    User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referee     User     @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([refereeId]) // one referral per new user
  @@index([referrerId])
  @@map("referrals")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Topics and Subtopics for SAT Content Organization
model Topic {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Algebra", "Reading Comprehension"
  moduleType  String   // 'reading-writing' | 'math'
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subtopics   Subtopic[]

  @@map("topics")
}

model Subtopic {
  id              String   @id @default(cuid())
  topicId         String
  name            String   // e.g., "Linear Equations", "Main Ideas"
  description     String?
  targetQuestions Int      @default(100) // Target number of questions
  currentCount    Int      @default(0)   // Current number of questions
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  topic           Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions       Question[]

  @@unique([topicId, name])
  @@map("subtopics")
}

// Enhanced SAT Questions Model
model Question {
  id           String   @id @default(cuid())
  questionIndex Int?    // Editable index for admin question management/order
  subtopicId   String?  // Link to subtopic
  moduleType   String   // 'reading-writing' | 'math'
  difficulty   String   // 'easy' | 'medium' | 'hard'
  category     String   // 'algebra', 'geometry', 'reading-comprehension', etc.
  subtopic     String?  // More specific subtopic (e.g., 'linear-equations', 'quadratic-functions')
  // V3 Generator fields (Epic #34)
  visualType   String?  // 'bar-chart' | 'line-graph' | 'scatter-plot' | 'pie-chart' | 'table' | 'function-graph' | 'geometry' | 'system-of-equations' | 'none'
  difficultyScore Int?  // Numeric difficulty (easy=25, medium=50, hard=75) for fine-grained filtering
  question     String   @db.Text
  passage      String?  @db.Text // Reading passages or context
  options      String   @db.Text // JSON array of answer options
  correctAnswer Int     // Index of correct answer (0-3)
  explanation  String   @db.Text // Detailed explanation for correct answer
  wrongAnswerExplanations String? @db.Text // JSON object for wrong answer explanations
  imageUrl     String?  // URL for math charts, graphs, diagrams (legacy filesystem path or new DB reference)
  imageData    Bytes?   // Stored SVG/image data as blob
  imageMimeType String? // MIME type of stored image (e.g., 'image/svg+xml', 'image/png')
  imageAlt     String?  // Alt text for accessibility
  chartData    String?  @db.Text // JSON for chart/graph data
  timeEstimate Int      // Estimated time in seconds
  source       String?  // Source of the question (e.g., 'Official SAT', 'Khan Academy')
  tags         String   @db.Text // JSON array of tags
  isActive     Boolean  @default(true)
  isReserved   Boolean  @default(false) // Epic #61: Marks questions reserved for fixed practice tests
  // Review fields for question quality control
  reviewStatus      String?  // 'pending' | 'approved' | 'rejected'
  reviewRating      Int?     // Rating 1-5 from admin review
  diagramAccurate   Boolean? // Whether diagram/chart is accurate (admin review)
  reviewComments    String?  @db.Text // Reviewer's feedback
  reviewedBy        String?  // Reviewer's identifier (could be user ID or name)
  reviewedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  subtopicRef     Subtopic? @relation(fields: [subtopicId], references: [id])
  questionResults QuestionResult[]
  questionReviews QuestionReview[]
  practiceTestQuestions PracticeTestQuestion[] // Epic #61: Practice test assignments

  @@index([moduleType, difficulty, category])
  @@index([category, subtopic])
  @@index([subtopicId])
  @@index([isActive, isReserved, moduleType]) // Epic #61: For random test exclusion
  @@map("questions")
}

// Archived Questions Model - For historical storage
model ArchivedQuestion {
  id           String   @id @default(cuid())
  originalId   String?  // ID from the original Question table
  subtopicId   String?
  moduleType   String
  difficulty   String
  category     String
  subtopic     String?
  question     String   @db.Text
  passage      String?  @db.Text
  options      String   @db.Text
  correctAnswer Int
  explanation  String   @db.Text
  wrongAnswerExplanations String? @db.Text
  imageUrl     String?
  imageData    Bytes?
  imageMimeType String?
  imageAlt     String?
  chartData    String?  @db.Text
  timeEstimate Int
  source       String?
  tags         String   @db.Text
  isActive     Boolean  @default(false)
  reviewStatus      String?
  reviewRating      Int?
  diagramAccurate   Boolean?
  reviewComments    String?  @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime @default(now())

  @@index([moduleType, difficulty, category])
  @@map("archived_questions")
}

// Question Review Model - User reviews for questions
model QuestionReview {
  id          String   @id @default(cuid())
  questionId  String
  userId      String
  rating      Int      // Star rating (1-5)
  description String?  @db.Text // Optional review description
  hasDiagram  Boolean  @default(false) // Diagram checkbox
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId]) // One review per user per question
  @@index([questionId])
  @@index([userId])
  @@map("question_reviews")
}

// Test Results Model
model TestResult {
  id               String   @id @default(cuid())
  userId           String
  practiceTestId   String?  // Epic #61: Link to fixed practice test (nullable for random tests)
  attemptNumber    Int?     // Epic #61: Attempt counter per practice test per user
  startTime        DateTime
  endTime          DateTime
  totalTimeSpent   Int      // seconds
  totalQuestions   Int
  correctAnswers   Int
  score            Int      // percentage
  satTotalScore    Int?     // SAT score 400-1600
  satReadingScore  Int?     // Reading & Writing score 200-800
  satMathScore     Int?     // Math score 200-800
  percentile       Int?     // 1-99 percentile
  categoryPerformance String  @db.Text // JSON record of category performance
  subtopicPerformance String? @db.Text // JSON for subtopic breakdown
  difficultyPerformance String? @db.Text // JSON for difficulty performance
  completedAt      DateTime @default(now())

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceTest    PracticeTest?    @relation(fields: [practiceTestId], references: [id]) // Epic #61
  questionResults QuestionResult[]

  @@index([userId, completedAt])
  @@index([satTotalScore])
  @@index([userId, practiceTestId]) // Epic #61: For attempt queries
  @@map("test_results")
}

// Individual Question Results
model QuestionResult {
  id            String   @id @default(cuid())
  testResultId  String
  questionId    String
  userAnswer    Int      // User's selected answer index
  isCorrect     Boolean
  timeSpent     Int      // seconds spent on this question
  createdAt     DateTime @default(now())

  // Relations
  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])

  @@index([testResultId])
  @@index([questionId])
  @@map("question_results")
}

// Epic #61: Fixed SAT Practice Tests
model PracticeTest {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "SAT Practice Test 1"
  description String?  @db.Text
  difficulty  String   // "diagnostic" | "standard" | "advanced"
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  questions   PracticeTestQuestion[]
  testResults TestResult[]

  @@map("practice_tests")
}

// Epic #61: Join table for fixed practice test questions with ordering
model PracticeTestQuestion {
  id             String @id @default(cuid())
  practiceTestId String
  questionId     String
  moduleIndex    Int    // 0=RW-1, 1=RW-2, 2=Math-1, 3=Math-2 (maps to MODULE_CONFIGS)
  orderIndex     Int    // 0-97 global ordering within the test

  // Relations
  practiceTest PracticeTest @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id])

  @@unique([practiceTestId, orderIndex])
  @@unique([practiceTestId, questionId])
  @@index([practiceTestId, moduleIndex])
  @@map("practice_test_questions")
}

// User Analytics and Progress Tracking
model UserAnalytics {
  id                    String   @id @default(cuid())
  userId                String   @unique
  totalTestsTaken       Int      @default(0)
  averageScore          Float    @default(0)
  totalTimeSpent        Int      @default(0) // total seconds across all tests
  strongestCategory     String?
  weakestCategory       String?
  strongestSubtopic     String?
  weakestSubtopic       String?
  improvementRate       Float    @default(0) // score improvement over time
  lastTestDate          DateTime?
  streakDays            Int      @default(0) // consecutive days of practice
  totalQuestionsAnswered Int     @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("user_analytics")
}

// Category Performance Tracking
model CategoryPerformance {
  id           String   @id @default(cuid())
  userId       String
  category     String   // 'algebra', 'geometry', etc.
  subtopic     String?  // More specific subtopic
  totalAnswered Int     @default(0)
  totalCorrect Int      @default(0)
  averageTime  Float    @default(0) // average seconds per question
  lastPracticed DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category, subtopic])
  @@index([userId])
  @@map("category_performance")
}

// Study Sessions for tracking practice patterns
model StudySession {
  id              String   @id @default(cuid())
  userId          String
  startTime       DateTime
  endTime         DateTime?
  questionsAnswered Int    @default(0)
  timeSpent       Int      @default(0) // seconds
  sessionType     String   // 'practice', 'full-test', 'category-focus'
  categories      String?  @db.Text // JSON array of categories practiced
  subtopics       String?  @db.Text // JSON array of subtopics practiced
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, startTime])
  @@map("study_sessions")
}

// Feedback and Error Tracking
model ErrorLog {
  id        String   @id @default(cuid())
  userId    String?
  errorType String   // 'api_error', 'client_error', 'database_error'
  message   String   @db.Text
  stack     String?  @db.Text
  metadata  String?  @db.Text // JSON metadata
  createdAt DateTime @default(now())

  @@index([errorType, createdAt])
  @@map("error_logs")
}

// App Usage Analytics
model UsageAnalytics {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // 'test_started', 'question_answered', 'test_completed'
  metadata    String?  @db.Text // JSON metadata about the action
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("usage_analytics")
}

// Stripe usage tracking per month
model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'practice_test' | 'drill'
  year      Int      // e.g., 2026
  month     Int      // 1-12
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, type, year, month])
  @@index([userId])
  @@map("usage_records")
}

// ─────────────────────────────────────────────
// COMPREHENSIVE ANALYTICS TABLES
// ─────────────────────────────────────────────

// Survey/Onboarding: tracks each answer + time spent per question
model SurveyResponse {
  id             String   @id @default(cuid())
  userId         String
  surveyType     String   // 'onboarding' | 'feedback' | 'exit'
  stepNumber     Int      // Which step/question (1-indexed)
  stepName       String   // e.g., 'grade_level', 'sat_score', 'strengths'
  answer         String?  @db.Text // JSON-encoded answer value
  timeSpentMs    Int      // Milliseconds spent on this step
  skipped        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, surveyType])
  @@index([surveyType, stepNumber])
  @@map("survey_responses")
}

// Page/Section time tracking
model PageView {
  id              String   @id @default(cuid())
  userId          String?  // Nullable for anonymous visitors
  sessionId       String   // Browser session ID (generated client-side)
  pagePath        String   // e.g., '/practice', '/pricing', '/onboarding'
  pageSection     String?  // Optional section within page (e.g., 'hero', 'pricing-cards')
  enteredAt       DateTime // When user entered the page/section
  dwellTimeMs     Int      // How long they stayed (milliseconds)
  scrollDepthPct  Int?     // How far they scrolled (0-100)
  referrer        String?  // Previous page path
  userAgent       String?
  deviceType      String?  // 'mobile' | 'tablet' | 'desktop'
  createdAt       DateTime @default(now())

  @@index([userId, pagePath])
  @@index([pagePath, createdAt])
  @@index([sessionId])
  @@map("page_views")
}

// Drill/Practice session-level tracking
model DrillAttempt {
  id              String   @id @default(cuid())
  userId          String
  category        String   // e.g., 'algebra', 'reading-comprehension', 'mixed'
  moduleType      String?  // 'reading-writing' | 'math' | null for mixed
  difficulty      String?  // 'easy' | 'medium' | 'hard' | null for mixed
  totalQuestions  Int
  correctAnswers  Int
  score           Int      // percentage
  totalTimeMs     Int      // Total time for entire drill in ms
  avgTimePerQ     Int      // Average ms per question
  fastestTimeMs   Int?     // Fastest question answer time
  slowestTimeMs   Int?     // Slowest question answer time
  streakCorrect   Int      @default(0) // Longest correct streak in this drill
  streakWrong     Int      @default(0) // Longest wrong streak
  startedAt       DateTime
  completedAt     DateTime
  abandoned       Boolean  @default(false) // Did they quit early?
  questionsLeft   Int      @default(0) // How many left if abandoned
  createdAt       DateTime @default(now())

  // Relations
  questionResults DrillQuestionResult[]

  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([category, difficulty])
  @@map("drill_attempts")
}

// Per-question result within a drill
model DrillQuestionResult {
  id              String   @id @default(cuid())
  drillAttemptId  String
  questionId      String
  questionIndex   Int      // Order within the drill (0-indexed)
  category        String   // Question's category
  difficulty      String   // Question's difficulty
  moduleType      String   // Question's module type
  userAnswer      Int      // Selected answer index
  correctAnswer   Int      // Correct answer index
  isCorrect       Boolean
  timeSpentMs     Int      // Ms spent on this question
  changedAnswer   Boolean  @default(false) // Did they change their answer?
  initialAnswer   Int?     // First answer if changed
  createdAt       DateTime @default(now())

  // Relations
  drillAttempt DrillAttempt @relation(fields: [drillAttemptId], references: [id], onDelete: Cascade)

  @@index([drillAttemptId])
  @@index([questionId])
  @@index([category, difficulty, isCorrect])
  @@map("drill_question_results")
}

// Generic user events for behavior tracking
model UserEvent {
  id          String   @id @default(cuid())
  userId      String?  // Nullable for anonymous
  sessionId   String?  // Browser session ID
  eventType   String   // 'click', 'signup', 'subscription_start', 'milestone', 'feature_use', etc.
  eventName   String   // e.g., 'start_practice_test', 'view_explanation', 'toggle_theme'
  metadata    String?  @db.Text // JSON payload with event-specific data
  pagePath    String?  // Which page this happened on
  createdAt   DateTime @default(now())

  @@index([userId, eventType])
  @@index([eventType, eventName])
  @@index([createdAt])
  @@map("user_events")
}

// Daily aggregated activity per user
model UserDailyActivity {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime @db.Date // The calendar date
  totalTimeMs         Int      @default(0) // Total time on site (ms)
  questionsAnswered   Int      @default(0)
  questionsCorrect    Int      @default(0)
  drillsCompleted     Int      @default(0)
  testsCompleted      Int      @default(0)
  pagesVisited        Int      @default(0)
  loginCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_daily_activity")
}

// Click and mouse-movement positions for heatmap analytics
model ClickEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  pagePath  String   // e.g. '/practice', '/pricing'
  xPct      Float    // x as % of viewport width (0-100)
  yPct      Float    // y as % of viewport height (0-100)
  element   String?  // simplified tag: 'button', 'a', 'input', etc.
  label     String?  // button text / aria-label (max 80 chars)
  eventType String   @default("click") // 'click' | 'move'
  createdAt DateTime @default(now())

  @@index([pagePath, createdAt])
  @@index([userId])
  @@map("click_events")
}

// Site feedback / review widget submissions
model UserFeedback {
  id          String   @id @default(cuid())
  userId      String?  // null for anonymous
  sessionId   String?  // anonymous identifier from localStorage
  rating      Int      // 1-5
  review      String?  @db.Text // optional, max 500 chars
  userAgent   String?  @db.Text
  pageUrl     String?
  submittedAt DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("user_feedback")
}
