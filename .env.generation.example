# Example environment configuration for run-generation-enhanced.js
# Copy this to a .env file or export these variables before running the script

# Server Configuration
BASE_URL=http://localhost:3000
# BASE_URL=https://your-production-url.com

# Authentication (choose one)
# Option 1: Use session-based auth (default - must be logged in to admin account)
# Option 2: Use API key auth (for CI/CD and automation)
# ADMIN_API_KEY=your-secret-api-key

# Generation Settings
QUESTION_COUNT=10          # Questions per batch (1-50)
BATCH_COUNT=3              # Number of batches to run
BATCH_SIZE=5               # Questions per request (1-10)
DELAY_BETWEEN_BATCHES=15000 # Milliseconds between batches

# Content Filters (optional)
# MODULE_TYPE=math                    # math | reading-writing
# DIFFICULTY=medium                   # easy | medium | hard
# TOPIC_ID=clq1234567                # Specific topic ID
# SUBTOPIC_ID=clq7654321             # Specific subtopic ID

# AI Settings
TEMPERATURE=0.7            # AI creativity (0-2)
MAX_TOKENS=4000           # Max response length (1000-8000)
INCLUDE_CHARTS=true       # Include charts for math questions
INCLUDE_PASSAGES=true     # Include passages for reading questions

# Reliability Settings
RETRY_ATTEMPTS=3          # Number of retry attempts on failure
RETRY_DELAY=5000          # Milliseconds between retries

# Usage Examples:
# 
# 1. Basic usage (10 questions, 1 batch):
#    node run-generation-enhanced.js
#
# 2. Generate 30 math questions across 3 batches:
#    MODULE_TYPE=math QUESTION_COUNT=10 BATCH_COUNT=3 node run-generation-enhanced.js
#
# 3. Generate hard difficulty questions:
#    DIFFICULTY=hard QUESTION_COUNT=15 node run-generation-enhanced.js
#
# 4. Use API key for automation:
#    ADMIN_API_KEY=your-key BASE_URL=https://prod.com QUESTION_COUNT=20 node run-generation-enhanced.js
