# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration (Neon PostgreSQL)
# Recommended for most uses (pooled connection)
DATABASE_URL=postgres://user:password@host-pooler.region.neon.tech/dbname?sslmode=require

# For uses requiring a connection without pgbouncer (direct connection)
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require

# Optional: Additional PostgreSQL connection parameters
PGHOST=your-host-pooler.region.neon.tech
PGHOST_UNPOOLED=your-host.region.neon.tech
PGUSER=your-username
PGDATABASE=your-database-name
PGPASSWORD=your-password

# Optional: Vercel Postgres Templates format
POSTGRES_URL=postgres://user:password@host-pooler.region.neon.tech/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@host.region.neon.tech/dbname?sslmode=require
POSTGRES_USER=your-username
POSTGRES_HOST=your-host-pooler.region.neon.tech
POSTGRES_PASSWORD=your-password
POSTGRES_DATABASE=your-database-name
POSTGRES_URL_NO_SSL=postgres://user:password@host-pooler.region.neon.tech/dbname
POSTGRES_PRISMA_URL=postgres://user:password@host-pooler.region.neon.tech/dbname?connect_timeout=15&sslmode=require

# Optional: Azure OpenAI (for question generation - REQUIRED for production)
# Get these from Azure Portal → Azure OpenAI Service → Keys and Endpoint

# Option 1: Direct endpoint URL (recommended)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
ENDPOINT_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview

# Option 2: Component configuration (alternative to ENDPOINT_URL)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional: Separate endpoint for quality evaluation (defaults to ENDPOINT_URL if not set)
# GROK_ENDPOINT=https://your-grok-endpoint.openai.azure.com/openai/deployments/grok/chat/completions?api-version=2025-01-01-preview

# How to get these values:
# 1. Go to Azure Portal (https://portal.azure.com)
# 2. Navigate to Azure OpenAI Service
# 3. Select your resource
# 4. Go to "Keys and Endpoint":
#    - Copy "Key 1" → AZURE_OPENAI_API_KEY
#    - Copy "Endpoint" → use in ENDPOINT_URL or AZURE_OPENAI_ENDPOINT
# 5. Go to "Model deployments":
#    - Note deployment name (e.g., "gpt-4o") → AZURE_OPENAI_DEPLOYMENT

# IMPORTANT FOR VERCEL:
# - These variables MUST be set in Vercel Dashboard → Settings → Environment Variables
# - .env files are NOT deployed to Vercel (in .gitignore)
# - Missing these will cause 500 errors on question generation endpoint
# - See docs/VERCEL_ENV_SETUP.md for detailed setup instructions

# Optional: Stack Auth (if using alternative auth)
NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-key
STACK_SECRET_SERVER_KEY=your-stack-secret-key
