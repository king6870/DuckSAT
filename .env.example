# DuckSAT Application Environment Variables
# Copy this file to .env.local for local development
# For production/Vercel: Set these in Vercel Dashboard → Settings → Environment Variables

# ============================================================================
# CRITICAL: NextAuth Configuration
# ============================================================================

# NextAuth Secret - Used to encrypt session tokens
# REQUIRED in production
# Generate with: openssl rand -base64 32
# ⚠️ NEVER commit the actual secret to Git
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# NextAuth URL - Canonical URL of your application
# REQUIRED in production
# Examples:
#   Development: http://localhost:3000
#   Production: https://yourdomain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# Google OAuth Configuration
# ============================================================================

# Google OAuth Client ID and Secret
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# REQUIRED for authentication to work
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================================================
# Database Configuration
# ============================================================================

# Database URL with connection pooling (for serverless functions)
# Example for Neon: postgresql://user:password@host/database?pgbouncer=true
DATABASE_URL=your-database-url-with-pooling

# Database URL without pooling (for migrations and schema operations)
# Example for Neon: postgresql://user:password@host/database
DATABASE_URL_UNPOOLED=your-database-url-without-pooling

# ============================================================================
# Optional: Diagnostic Configuration
# ============================================================================

# Enable enhanced diagnostics in production (use only for debugging)
# Set to 'true' to enable /api/env diagnostics in production
# Remove this variable after debugging is complete
# ALLOW_ENV_DIAGNOSTICS=false

# ============================================================================
# IMPORTANT NOTES FOR VERCEL DEPLOYMENTS
# ============================================================================
#
# 1. This .env.example file is for reference only
# 2. .env and .env.local files are NOT deployed to Vercel (they're in .gitignore)
# 3. You MUST set variables in Vercel Dashboard UI:
#    - Go to your project in Vercel
#    - Navigate to Settings → Environment Variables
#    - Add each variable listed above
#    - Select appropriate environments (Production, Preview, Development)
#    - Redeploy after adding/updating variables
#
# 4. Build-time vs Runtime:
#    - Variables are checked at build time (scripts/check-env.js)
#    - Runtime availability depends on Vercel Dashboard settings
#    - Use /api/env to verify runtime variable loading
#
# 5. Security:
#    - NEVER commit actual secrets to Git
#    - Use different secrets for different environments
#    - Rotate NEXTAUTH_SECRET periodically (invalidates all sessions)
#    - Never expose secrets in client-side code
#
# For detailed setup instructions, see:
# - docs/VERCEL_ENV_SETUP.md
# - README.md
#
# ============================================================================
